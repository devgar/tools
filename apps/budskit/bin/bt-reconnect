#!/usr/bin/env bash
# bt-reconnect - resilient reconnect for a paired Bluetooth audio device.
#
# Talks to BlueZ over D-Bus (busctl) instead of driving bluetoothctl interactively,
# so failures come back as precise org.bluez error names and nothing ever blocks
# on a "Scan and connect (yes,no)" prompt.
#
# Usage: bt-reconnect [MAC] [-n TRIES] [-q] [--no-audio] [--reset]
set -uo pipefail

MAC_DEFAULT="3C:B0:ED:D1:A4:AB"   # CMF Buds 2
TRIES=4
QUIET=0
DO_AUDIO=1
FORCE_RESET=0
MAC=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -n|--tries)   TRIES="$2"; shift 2 ;;
        -q|--quiet)   QUIET=1; shift ;;
        --no-audio)   DO_AUDIO=0; shift ;;
        --reset)      FORCE_RESET=1; shift ;;
        -h|--help)
            sed -n '/^# bt-reconnect/,/^# Usage:/p' "$0" | sed 's/^# \?//'
            exit 0 ;;
        *)            MAC="$1"; shift ;;
    esac
done
MAC="${MAC:-${BT_DEVICE:-$MAC_DEFAULT}}"
MAC="${MAC^^}"

DEV_PATH="/org/bluez/hci0/dev_${MAC//:/_}"
ADAPTER=/org/bluez/hci0

log()  { [[ $QUIET -eq 1 ]] || printf '%s\n' "$*" >&2; }
step() { [[ $QUIET -eq 1 ]] || printf '\033[1;34m==>\033[0m %s\n' "$*" >&2; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31mxx\033[0m %s\n' "$*" >&2; notify "Reconnect failed" "$*"; exit 1; }

notify() {
    command -v notify-send >/dev/null || return 0
    notify-send -a bt-reconnect -i audio-headset "$1" "${2:-}" 2>/dev/null || true
}

prop() {  # prop <interface> <name> -> bare value
    busctl --no-pager get-property org.bluez "$2" "$1" "$3" 2>/dev/null \
        | awk '{ $1=""; sub(/^ /,""); gsub(/^"|"$/,""); print }'
}

dev_prop()     { prop org.bluez.Device1  "$DEV_PATH" "$1"; }
adapter_prop() { prop org.bluez.Adapter1 "$ADAPTER"  "$1"; }

call() {  # call <path> <interface> <method> ; prints error text on stdout, returns status
    busctl --no-pager call org.bluez "$1" "$2" "$3" 2>&1
}

# Device1.Connect can legitimately run past the default 25 s D-Bus reply timeout,
# and BlueZ often completes the connection *after* it has already replied with an
# error - so every caller must re-check Connected rather than trust the status.
call_connect() {
    busctl --no-pager --timeout=45 call org.bluez "$DEV_PATH" org.bluez.Device1 Connect 2>&1
}

# Wait for an attempt that BlueZ is still working on in the background.
wait_settle() {
    local n=${1:-20}
    for ((w = 0; w < n; w++)); do
        is_connected && return 0
        sleep 1
    done
    return 1
}

is_connected() { [[ "$(dev_prop Connected)" == "true" ]]; }

# A2DP is what actually carries audio; Connected=yes with no transport is a half-open link.
has_transport() {
    busctl --no-pager tree org.bluez 2>/dev/null | grep -q "${DEV_PATH#/}.*/fd[0-9]"
}

audio_sink() {
    command -v pactl >/dev/null || return 1
    pactl list sinks short 2>/dev/null | awk -v m="${MAC//:/_}" '$2 ~ m { print $2; found=1 } END { exit !found }'
}

battery() { prop org.bluez.Battery1 "$DEV_PATH" Percentage; }

set_default_sink() {
    local sink
    sink=$(audio_sink) || return 0
    pactl set-default-sink "$sink" 2>/dev/null && log "Default sink -> $sink"
}

power_cycle() {
    step "Power-cycling the adapter"
    busctl set-property org.bluez "$ADAPTER" org.bluez.Adapter1 Powered b false
    sleep 3
    busctl set-property org.bluez "$ADAPTER" org.bluez.Adapter1 Powered b true
    sleep 4
}

# A short scan burst wakes a device that stopped answering pages. Scan *then stop*:
# connecting while the radio is still scanning is markedly less reliable.
nudge() {
    call "$ADAPTER" org.bluez.Adapter1 StartDiscovery >/dev/null 2>&1 || return 0
    sleep 4
    call "$ADAPTER" org.bluez.Adapter1 StopDiscovery >/dev/null 2>&1
    sleep 1
}

explain() {
    case "$1" in
        *page-timeout*)
            warn "The buds did not answer the page. They are asleep, in the closed case,"
            warn "or attached to another host - CMF Buds 2 are multipoint and will happily"
            warn "stay on your phone. Open the lid / take one bud out, or disconnect them there." ;;
        *profile-unavailable*|*profile-unsupported*)
            warn "The buds answered but refused the audio profiles - usually a stale link key"
            warn "on their side. Escalating to a power cycle." ;;
        *InProgress*|*connection-busy*)
            warn "BlueZ already has a connect in flight; waiting it out." ;;
        *"Connection timed out"*)
            warn "BlueZ took longer than the D-Bus reply timeout - the attempt may still land." ;;
        *NotReady*)
            warn "Adapter reports not-ready." ;;
        *AlreadyConnected*) : ;;
        *)  warn "$1" ;;
    esac
}

# ---------------------------------------------------------------- preflight

[[ -n "$(busctl --no-pager tree org.bluez 2>/dev/null)" ]] || die "bluetoothd is not reachable on D-Bus"
[[ -n "$(dev_prop Paired)" ]] || die "$MAC is not a known device (pair it first)"

if [[ "$(adapter_prop Powered)" != "true" ]]; then
    step "Adapter is off - powering on"
    busctl set-property org.bluez "$ADAPTER" org.bluez.Adapter1 Powered b true \
        || die "could not power on the adapter"
    sleep 2
fi

if [[ "$(dev_prop Trusted)" != "true" ]]; then
    step "Marking device trusted (lets BlueZ auto-reconnect on its own)"
    busctl set-property org.bluez "$DEV_PATH" org.bluez.Device1 Trusted b true || true
fi

if is_connected && has_transport && [[ $FORCE_RESET -eq 0 ]]; then
    log "Already connected with an active audio transport."
    [[ $DO_AUDIO -eq 1 ]] && set_default_sink
    exit 0
fi

# A leftover discovery session (bluetui / a stale bluetoothctl) keeps the radio busy
# and is a common reason a connect attempt times out. Ours we can stop; someone
# else's we can only report.
if [[ "$(adapter_prop Discovering)" == "true" ]]; then
    out=$(call "$ADAPTER" org.bluez.Adapter1 StopDiscovery)
    if [[ $? -eq 0 ]]; then
        step "Stopped a discovery session we owned"
        sleep 1
    else
        warn "Adapter is still scanning and the session belongs to another client"
        warn "(bluetui or a leftover bluetoothctl). Close it if the connect below fails."
    fi
fi

if is_connected; then
    step "Link is half-open (connected, no audio transport) - dropping it first"
    call "$DEV_PATH" org.bluez.Device1 Disconnect >/dev/null
    sleep 2
fi

# ---------------------------------------------------------------- connect loop

for ((i = 1; i <= TRIES; i++)); do
    step "Connect attempt $i/$TRIES"
    err=$(call_connect)
    rc=$?

    # "busy" / reply-timeout mean the attempt is still running inside BlueZ.
    if [[ $rc -ne 0 && "$err" != *AlreadyConnected* ]] && ! is_connected; then
        case "$err" in
            *connection-busy*|*InProgress*|*"Connection timed out"*)
                log "    attempt still running inside BlueZ - waiting for it to settle"
                wait_settle 25 ;;
        esac
    fi

    if [[ $rc -eq 0 ]] || [[ "$err" == *AlreadyConnected* ]] || is_connected; then
        # Connect() returns as soon as one profile is up; give A2DP a moment to settle.
        for _ in {1..10}; do
            has_transport && break
            sleep 1
        done
        if has_transport; then
            log ""
            log "Connected: $(dev_prop Name)  [BlueZ battery: $(battery)%]"
            [[ $DO_AUDIO -eq 1 ]] && set_default_sink
            notify "$(dev_prop Name) connected" "Audio transport is up"
            exit 0
        fi
        warn "Connected but no A2DP transport appeared - retrying"
        call "$DEV_PATH" org.bluez.Device1 Disconnect >/dev/null
        sleep 2
        continue
    fi

    explain "$err"

    if [[ $i -lt $TRIES ]]; then
        # Escalate: nudge first, power-cycle from the third attempt on.
        if [[ $i -ge 2 ]]; then
            power_cycle
        else
            nudge
        fi
        sleep $((i * 2))
    fi
done

die "gave up after $TRIES attempts"
