# Expects the pre-built daemon binary in the build context:
#   postkit-daemon   — the daemon binary
#
# Build locally after cargo build --release:
#   docker build -t postkit .

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY postkit-daemon .

VOLUME ["/data", "/config"]
EXPOSE 8080

ENTRYPOINT ["./postkit-daemon"]
CMD ["--config", "/config/daemon.toml"]
